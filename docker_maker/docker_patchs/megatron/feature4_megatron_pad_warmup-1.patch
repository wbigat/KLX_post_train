+# Copyright (c) ModelScope Contributors. All rights reserved.
+"""Pad-warmup for padding_free megatron training: pad the first batch(es) to the peak packed
+length to fight memory fragmentation when `expandable_segments` is unavailable.
+
+Why
+---
+With `padding_free`, a micro-batch is one packed row whose length is the *sum* of the sample
+lengths, so it varies with the data order. On allocators without `expandable_segments`, the
+caching allocator cannot grow a freed segment in place: once the memory is carved into small
+segments by early (short) batches, a later (longer) batch cannot find a contiguous block even
+though the *total* free memory is enough:
+
+    torch.OutOfMemoryError: Tried to allocate 15.60 GiB. GPU 3 has a total capacity of 96.00 GiB
+    of which 38.53 GiB is free...
+
+The fix: pad the FIRST batch to the peak packed length, so the allocator reserves the big
+segments up-front and every later batch -- whose length is <= the warm-up one -- reuses them.
+
+How (dummy segment)
+-------------------
+A single dummy sample of ``warmup_len - real_total`` tokens is appended to the batch before
+``packing_row``. ``packing_row`` assigns it ``position_ids = range(pad)``, so it becomes ONE
+extra segment in ``cu_seqlens`` (a segment boundary is every ``position_ids == 0``). The dummy
+keeps ``labels = -100`` / ``loss_scale = 0``, so it contributes neither loss nor gradient, and
+being a separate causal segment it cannot influence the real tokens.
+
+Padding length
+--------------
+* packing:      the peak is the packing length itself -> ``max_length``;
+* non-packing:  ``min(micro_batch_size * max_length, sum of the top-micro_batch_size sample
+  lengths)`` (an exact upper bound of any shuffled micro-batch total), aligned up to
+  ``get_padding_to(args)``.
+
+``SWIFT_PAD_WARMUP_LENGTH`` overrides everything and is used as-is (then aligned).
+
+Guarantees / caveats
+--------------------
+* No extra step and no dummy forward/backward: the warm-up batch is a real training micro-batch.
+* LM loss / gradient is unchanged (``labels=-100``, ``loss_scale=0``).
+* The dummy tokens are *sampled from the real batch* (not a single pad id), so the MoE router
+  sees a near-real token distribution and the load-balancing stays balanced.
+* MoE aux loss of the warm-up micro-batch still differs slightly (aux loss is not scaled by
+  ``loss_scale``); it only affects the warm-up micro-batches.
+* Only enabled for plain causal-LM training (``mode in {'transformers', 'train'}``). RLHF/PRM
+  trainers index per-segment logits via ``packed_seq_params.seq_lens``; an extra segment would
+  shift the count, so they are excluded.
+* ``context_parallel_size > 1`` is not supported.
+
+Usage
+-----
+    SWIFT_PAD_WARMUP=1                 # 0 disables it (A/B comparison)
+    SWIFT_PAD_WARMUP_LENGTH=8192       # explicit target packed length
+"""
+import math
+import os
+from typing import Any, Callable, Dict, List, Optional
+
+from swift.utils import get_env_args, get_logger
+
+logger = get_logger()
+
+# How many of the first micro-batches each dataloader worker pads to the warm-up length.
+_WARMUP_BATCHES = 1
+
+
+def _scan_num_proc(args) -> int:
+    """Number of fork workers for the length scan (scales with `dataset_num_proc`)."""
+    return max(1, min(32, (getattr(args, 'dataset_num_proc', 1) or 1) * 4))
+
+
+def _align(length: int, args) -> int:
+    """Round the warm-up length up to the attention-backend alignment (`get_padding_to`)."""
+    try:
+        from swift.megatron.utils.utils import get_padding_to
+        padding_to = get_padding_to(args)
+    except Exception:
+        padding_to = None
+    if padding_to:
+        return math.ceil(length / padding_to) * padding_to
+    return length
+
+
+def get_pad_warmup_length(args, dataset, template) -> Optional[int]:
+    """Resolve the warm-up peak length, ``None`` disables it.
+
+    统一 dummy 段方案, 与 padding_free 开关无关:
+    * padding_free: 行长 = Σ样本长度, 峰值 W = min(mbs * max_length, top-mbs 样本长度之和),
+      dummy 追加在 packing_row 之前, 独立成段;
+    * 非 padding_free: batch 形状 = [mbs, 批内最长样本], 峰值 W = min(max_length, 数据集最长样本),
+      dummy 为一条长度 W 的样本, 顶起整批右 pad 后在 collate 末尾切掉。
+    """
+    if not get_env_args('SWIFT_PAD_WARMUP', bool, True):
+        return None
+    if getattr(args, 'context_parallel_size', 1) > 1:
+        logger.info_once('[pad_warmup] Disabled: context_parallel_size > 1 is not supported.')
+        return None
+    if getattr(template, 'mode', 'train') not in ('transformers', 'train'):
+        # RLHF/PRM trainers index per-segment logits via packed_seq_params.seq_lens; an extra
+        # dummy segment would shift the segment count.
+        logger.info_once(f'[pad_warmup] Disabled: template.mode={getattr(template, "mode", None)!r}.')
+        return None
+
+    max_length = getattr(args, 'max_length', None) or getattr(args, 'seq_length', None)
+    if not max_length or max_length <= 0:
+        return None
+    max_length = int(max_length)
+
+    if getattr(args, 'packing', False):
+        # packing bins are capped at max_length, so that is the peak packed length.
+        return _align(max_length, args)
+
+    length = os.environ.get('SWIFT_PAD_WARMUP_LENGTH')
+    if length:
+        return _align(int(length), args)
+
+    padding_free = getattr(args, 'padding_free', False)
+    mbs = (getattr(args, 'micro_batch_size', 1) or 1) if padding_free else 1
+    top_sum = scan_topk_sample_length(dataset, template, args, k=mbs)
+    bound = mbs * max_length
+    if top_sum is None:
+        logger.warning(f'[pad_warmup] Dataset scan failed; fall back to {bound}.')
+        return _align(bound, args)
+    return _align(min(bound, top_sum), args)
+
+
+# The template is shared with the scan workers through fork (copy-on-write), because pickling it
+# (e.g. via `datasets.map(num_proc=...)`) drops the initialized processor.
+_SCAN_TEMPLATE = None
+
+
+def _scan_row(row: Dict[str, Any]) -> int:
+    """Map one dataset row to its token length; 0 for failed samples."""
+    try:
+        encoded = _SCAN_TEMPLATE.encode(row, return_length=True)
+        lengths = encoded.get('lengths') or [len(encoded['input_ids'])]
+        return max(lengths)
+    except Exception:
+        return 0
+
+
+def _topk_sum(lengths: List[int], k: int) -> Optional[int]:
+    vals = sorted((int(v) for v in lengths if v), reverse=True)[:max(1, k)]
+    return sum(vals) if vals else None
+
+
+def scan_topk_sample_length(dataset, template, args, k: int) -> Optional[int]:
+    """Scan once and return the sum of the top-`k` sample token lengths.
+
+    A shuffled micro-batch holds `k` samples, so its packed length never exceeds this sum. Uses a
+    precomputed `length(s)` column when available, otherwise runs `template.encode` over the whole
+    dataset once on rank 0 (fork pool), broadcasts the result and caches it on disk.
+    """
+    if dataset is None:
+        return None
+    try:
+        n = len(dataset)
+    except Exception:
+        return None
+    if n == 0:
+        return None
+
+    from swift.dataset.utils import LazyLLMDataset
+    hf_ds = dataset.dataset if isinstance(dataset, LazyLLMDataset) else dataset
+
+    # Fast path: a precomputed length column (lazy_tokenize=False).
+    for col in ('lengths', 'length'):
+        try:
+            vals = hf_ds[col]
+            if vals is not None and len(vals):
+                lengths = [(max(v) if isinstance(v, (list, tuple)) else int(v)) for v in vals]
+                return _topk_sum(lengths, k)
+        except Exception:
+            pass
+
+    # Exact scan on the global main rank, then broadcast.
+    import torch
+    import torch.distributed as dist
+    dist_inited = dist.is_available() and dist.is_initialized()
+    rank = dist.get_rank() if dist_inited else 0
+    if rank == 0:
+        top_sum = _scan_topk_rank0(hf_ds, template, args, n, k) or 0
+    else:
+        top_sum = 0
+    if dist_inited:
+        tensor = torch.tensor([top_sum], dtype=torch.long, device=torch.cuda.current_device())
+        dist.broadcast(tensor, src=0)
+        top_sum = int(tensor.item())
+    if rank == 0:
+        logger.info(f'[pad_warmup] sum of top-{k} sample lengths = {top_sum or None}.')
+    return top_sum or None
+
+
+def _scan_cache_path(args, k: int) -> str:
+    import hashlib
+    import json
+    key_src = json.dumps(
+        {
+            'dataset': getattr(args, 'dataset', None),
+            'max_length': getattr(args, 'max_length', None),
+            'template': getattr(args, 'template', None),
+            'micro_batch_size': k,
+            'fps': os.environ.get('FPS'),
+            'fps_max_frames': os.environ.get('FPS_MAX_FRAMES'),
+            'video_max_pixels': os.environ.get('VIDEO_MAX_PIXELS'),
+            'max_pixels': os.environ.get('MAX_PIXELS'),
+        },
+        sort_keys=True,
+        default=str)
+    digest = hashlib.md5(key_src.encode()).hexdigest()[:16]
+    cache_dir = os.path.join(os.path.expanduser('~'), '.cache', 'swift', 'pad_warmup')
+    os.makedirs(cache_dir, exist_ok=True)
+    return os.path.join(cache_dir, f'top{k}_sum_{digest}.txt')
+
+
+def _scan_topk_rank0(hf_ds, template, args, n: int, k: int) -> Optional[int]:
+    """Scan (on the main rank) for the top-k length sum, using the on-disk cache if present."""
+    cache_path = _scan_cache_path(args, k)
+    if os.path.isfile(cache_path):
+        try:
+            with open(cache_path) as f:
+                cached = int(f.read().strip())
+            logger.info(f'[pad_warmup] Using the cached top-{k} length sum: {cached} ({cache_path}).')
+            return cached
+        except Exception:
+            pass
+
+    global _SCAN_TEMPLATE
+    _SCAN_TEMPLATE = template
+    num_proc = _scan_num_proc(args)
+    logger.info(f'[pad_warmup] Scanning {n} samples (num_proc={num_proc})...')
+    try:
+        import multiprocessing as mp
+        with mp.get_context('fork').Pool(num_proc) as pool:
+            lengths = pool.map(_scan_row, hf_ds, chunksize=max(1, n // (num_proc * 8)))
+        top_sum = _topk_sum([v for v in lengths if v], k)
+        logger.info(f'[pad_warmup] Scan finished: {n} rows, top-{k} sum = {top_sum}.')
+    except Exception as e:
+        logger.warning(f'[pad_warmup] Failed to scan the dataset: {e}')
+        return None
+
+    if top_sum:
+        try:
+            with open(cache_path, 'w') as f:
+                f.write(str(top_sum))
+        except Exception:
+            pass
+    return top_sum
+
+
+class PadWarmupCollator:
+    """Wrap a data collator so that the first `num_batches` batch(es) are padded to `length`.
+
+    `num_batches` is consumed per process: with `dataloader_num_workers > 0` every worker owns a
+    copy of the collator and pads its own first batch(es).
+    """
+
+    def __init__(self, collator: Callable[..., Dict[str, Any]], length: int, num_batches: int = 1):
+        self.collator = collator
+        self.length = length
+        self.num_batches = num_batches
+
+    def __call__(self, batch: List[Dict[str, Any]], **kwargs) -> Dict[str, Any]:
+        if self.num_batches <= 0:
+            return self.collator(batch, **kwargs)
+        self.num_batches -= 1
+        logger.info_once(f'[pad_warmup] Padding the first batch to {self.length} (pid {os.getpid()}).',
+                         hash_id='pad_warmup')
+        return self.collator(batch, pad_to_length=self.length, **kwargs)
+
+    def __repr__(self) -> str:
+        return (f'PadWarmupCollator(length={self.length}, num_batches={self.num_batches}, '
+                f'collator={self.collator})')
+
+
+def wrap_pad_warmup(data_collator: Callable[..., Dict[str, Any]],
+                    args,
+                    dataset=None,
+                    template=None) -> Callable[..., Dict[str, Any]]:
+    """Pad the first batch(es) to the peak packed length, see the module docstring."""
+    length = get_pad_warmup_length(args, dataset, template)
+    if length is None:
+        return data_collator
+    logger.info_once(f'[pad_warmup] warmup: pad the first {_WARMUP_BATCHES} batch(es) '
+                     f'per dataloader worker to {length} '
+                     f'(padding_free={getattr(args, "padding_free", False)}).')
+    return PadWarmupCollator(data_collator, length, _WARMUP_BATCHES)
