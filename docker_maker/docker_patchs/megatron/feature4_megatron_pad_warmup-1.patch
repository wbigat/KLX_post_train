+    def _sample_dummy_text_ids(self, batch: List[Dict[str, Any]], n: int) -> List[int]:
+        """Sample `n` dummy input_ids from the TEXT tokens of the real batch.
+
+        仅从纯文本 token 中采样 dummy input_ids。多模态样本的媒体占位 token
+        (image/video_token_id) 数量必须与 ViT 输出的 embedding 数严格一致(masked_scatter),
+        若被采进 dummy 会导致越界访存(unspecified launch failure);
+        get_rope_index 也依赖媒体 token 与 grid_thw 一一对应, 缺失 grid 会算错 position_ids。
+        """
+        import random
+        exclude_ids = set(getattr(self.tokenizer, 'all_special_ids', None) or [])
+        for attr in ('image_token_id', 'video_token_id', 'audio_token_id'):
+            tid = getattr(self, attr, None)
+            if isinstance(tid, int):
+                exclude_ids.add(tid)
+        real_ids = []
+        for r in batch:
+            ids = r['input_ids']
+            ids = ids.tolist() if torch.is_tensor(ids) else list(ids)
+            mm_types = r.get('mm_token_type_ids')
+            if mm_types is not None:
+                mm_types = mm_types.tolist() if torch.is_tensor(mm_types) else list(mm_types)
+                ids = [i for i, t in zip(ids, mm_types) if t == 0]
+            real_ids.extend(i for i in ids if i not in exclude_ids)
+        return random.choices(real_ids, k=n) if real_ids else [self.tokenizer.pad_token_id] * n
+
+    def _pad_warmup_append_dummy(self, batch: List[Dict[str, Any]], target: Optional[int]) -> int:
+        """Append ONE dummy sample for pad-warmup (megatron SFT, both data layouts).
+
+        返回 1 表示追加的是普通 batch 的 dummy 行(collate 后需切除), 0 表示未追加或无需切除。
+
+        * padding_free(含 packing): dummy 把 packed 行补到 `target`, `packing_row` 逢 0 分段使其
+          成为独立新段, 因果隔离不影响真实 token;
+        * 普通 batch: dummy 长度 = 峰值样本长, 把整批右 pad 顶到 [mbs+1, W], 由
+          `_pad_warmup_pop_dummy` 在 collate 后切除, batch 内容精确回到 [mbs, W]。
+
+        dummy 恒为 labels=-100 / loss_scale=0, 且 input_ids 只从纯文本 token 采样
+        (`_sample_dummy_text_ids`), 对 loss/梯度/ViT/mrope 零影响。
+        """
+        if not (self.use_megatron and target and self.task_type == 'causal_lm'
+                and self.mode in {'transformers', 'train'}):
+            return 0
+        if any('input_ids' not in r for r in batch):
+            return 0
+        if self.padding_free:
+            total = sum((r.get('length') or len(r['input_ids'])) for r in batch)
+            dummy_len = int(target) - int(total)
+            need_pop = False
+        else:
+            # 普通 batch 的右 pad 由批内最长样本决定; 已达到峰值则无需 dummy
+            if max(len(r['input_ids']) for r in batch) >= int(target):
+                return 0
+            dummy_len = int(target)
+            need_pop = True
+        if dummy_len <= 0:
+            return 0
+        dummy_ids = self._sample_dummy_text_ids(batch, dummy_len)
+        dummy = {'input_ids': dummy_ids, 'labels': [-100] * dummy_len, 'length': dummy_len}
+        # 字段对齐: 各 1D 字段会被逐个 sum/cat/pad, dummy 缺字段会导致长度不齐
+        for key, pad_value in [('loss_scale', 0.), ('token_type_ids', 0)]:
+            if any(r.get(key) is not None for r in batch):
+                dummy[key] = [pad_value] * dummy_len
+        if any(r.get('mm_token_type_ids') is not None for r in batch):
+            # 多模态(mrope): packing_row 对 mm_token_type_ids 做 torch.cat, 缺失会崩;
+            # 全 0 表示纯文本 token, dummy 段/行不影响 ViT 与 mrope
+            dummy['mm_token_type_ids'] = torch.zeros(dummy_len, dtype=torch.int64)
+        first_channel = next((r.get('channel') for r in batch if r.get('channel') is not None), None)
+        if first_channel is not None:
+            # channel loss 按段/行索引 channels[i], dummy 需占位(loss 为 0)
+            dummy['channel'] = first_channel
+        batch.append(dummy)
+        return 1 if need_pop else 0
+
+    @staticmethod
+    def _pad_warmup_pop_dummy(res: Dict[str, Any], n_real: int) -> None:
+        """Slice off the dummy row appended by `_pad_warmup_append_dummy` (padded-batch layout),
+        so every per-sample field is exactly back to `n_real` rows."""
+        for key in ('input_ids', 'inputs_embeds', 'labels', 'loss_scale', 'token_type_ids',
+                    'mm_token_type_ids', 'attention_mask', 'attention_mask_2d', 'channel',
+                    'seq_lens', 'position_ids', 'text_position_ids'):
+            v = res.get(key)
+            if v is None:
+                continue
+            if torch.is_tensor(v):
+                if v.shape[0] == n_real + 1:
+                    res[key] = v[:-1]
+                elif key == 'position_ids' and v.ndim == 3 and v.shape[1] == n_real + 1:
+                    res[key] = v[:, :-1]  # mrope: (C, B, L)
+            elif isinstance(v, list) and len(v) == n_real + 1:
+                res[key] = v[:-1]
