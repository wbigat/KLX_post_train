+        for attr in ('image_token_id', 'video_token_id', 'audio_token_id'):
+            tid = getattr(self, attr, None)
+            if isinstance(tid, int):
+                exclude_ids.add(tid)
+        real_ids = []
+        for r in batch:
+            ids = r['input_ids']
